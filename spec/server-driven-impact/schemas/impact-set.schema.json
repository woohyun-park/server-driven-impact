{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "scope": {
            "enum": [
              "caller",
              "global"
            ]
          },
          "selector": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "all"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "inputs"
                  },
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "required": [
                  "kind",
                  "values"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "endpoint",
          "scope",
          "selector"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocolVersion",
    "targets"
  ],
  "additionalProperties": false
}
