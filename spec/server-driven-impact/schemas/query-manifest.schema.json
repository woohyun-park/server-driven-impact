{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reads": {
      "type": "object",
      "maxProperties": 512,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "resource": {
              "type": "string"
            },
            "columns": {
              "oneOf": [
                {
                  "const": "*"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "bindings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "string"
                  },
                  "input": {
                    "type": "string"
                  }
                },
                "required": [
                  "column",
                  "input"
                ],
                "additionalProperties": false
              }
            },
            "filters": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "string"
                  },
                  "value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                },
                "required": [
                  "column",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "resource",
            "columns",
            "bindings"
          ],
          "additionalProperties": false
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "dependents": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "reads"
  ],
  "additionalProperties": false
}
