  "keywords": ["cache", "invalidation", "impact", "sqlite"],
  "devDependencies": { "@server-driven-impact/core": "workspace:^", "@server-driven-impact/runtime": "workspace:^", "@types/node": "25.9.1", "typescript": "6.0.3" }
