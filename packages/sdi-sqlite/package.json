{
  "name": "@server-driven-impact/sqlite",
  "version": "0.1.1",
  "description": "SQLite adapter for server-driven impact.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "types": "./dist/sqlite/index.d.ts",
  "module": "./dist/sqlite/index.js",
