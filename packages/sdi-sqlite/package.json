  "repository": { "type": "git", "url": "git+https://github.com/woohyun-park/server-driven-impact.git", "directory": "packages/sdi-sqlite" },
  "homepage": "https://github.com/woohyun-park/server-driven-impact/tree/main/packages/sdi-sqlite#readme",
