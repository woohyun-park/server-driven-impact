{
  "name": "@server-driven-impact/postgres",
  "version": "0.5.0-impact.0",
  "description": "PostgreSQL adapter for server-driven impact.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "types": "./dist/postgres/index.d.ts",
  "module": "./dist/postgres/index.js",
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/postgres/index.d.ts",
      "import": "./dist/postgres/index.js"
    },
    "./pg": {
      "types": "./dist/pg/index.d.ts",
      "import": "./dist/pg/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "import": "./dist/drizzle/index.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "import": "./dist/prisma/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/backend/clean-sdi-package.mjs && tsc -p tsconfig.json && node ../../scripts/backend/annotate-sdi-package.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@pgsql/parser": "1.5.0"
  },
  "peerDependencies": {
    "@server-driven-impact/core": "^0.5.0-impact.0",
    "@server-driven-impact/runtime": "^0.5.0-impact.0",
    "drizzle-orm": "0.45.2",
    "pg": "8.16.3",
    "pg-copy-streams": "7.0.0",
    "postgres": "3.4.8",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/driver-adapter-utils": "7.10.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "pg-copy-streams": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "@prisma/adapter-pg": {
      "optional": true
    },
    "@prisma/driver-adapter-utils": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woohyun-park/server-driven-impact.git",
    "directory": "packages/sdi-postgres"
  },
  "homepage": "https://github.com/woohyun-park/server-driven-impact/tree/main/packages/sdi-postgres#readme",
  "bugs": {
    "url": "https://github.com/woohyun-park/server-driven-impact/issues"
  },
  "keywords": [
    "cache",
    "invalidation",
    "impact",
    "postgresql"
  ],
  "devDependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/driver-adapter-utils": "7.10.0",
    "@server-driven-impact/core": "workspace:^",
    "@server-driven-impact/runtime": "workspace:^",
    "@types/node": "25.9.1",
    "@types/pg": "8.15.5",
    "@types/pg-copy-streams": "1.2.5",
    "drizzle-orm": "0.45.2",
    "pg": "8.16.3",
    "pg-copy-streams": "7.0.0",
    "postgres": "3.4.8",
    "typescript": "6.0.3"
  }
}
