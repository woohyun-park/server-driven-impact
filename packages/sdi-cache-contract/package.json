{
  "name": "@server-driven-impact/cache-contract",
  "version": "0.5.0-cache-contract.2",
  "description": "Versioned cache-key contracts and invalidation compilation for Server-Driven Impact.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "files": ["dist", "README.md", "README.ko.md", "CHANGELOG.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "node ../../scripts/backend/clean-sdi-package.mjs && tsc -p tsconfig.json && node ../../scripts/backend/annotate-sdi-package.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": { "@server-driven-impact/core": "workspace:^" },
  "engines": { "node": ">=22.18" },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/woohyun-park/server-driven-impact.git", "directory": "packages/sdi-cache-contract" },
  "homepage": "https://github.com/woohyun-park/server-driven-impact/tree/main/packages/sdi-cache-contract#readme",
  "bugs": { "url": "https://github.com/woohyun-park/server-driven-impact/issues" },
  "keywords": ["cache", "invalidation", "openapi", "query-key"]
}
